---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Events">
  <section class="mx-auto max-w-3xl px-6 py-20">
    <div class="mb-4 flex items-center gap-3">
      <span class="h-[5px] w-[34px] bg-[var(--color-accent)]"></span>
      <span class="font-mono text-[11px] tracking-[0.22em] text-[var(--color-ink)]/55">EVENTS</span>
    </div>
    <h1 class="text-4xl">Events, coming soon</h1>
    <p class="prose-body mt-6 max-w-xl text-lg text-[var(--color-ink)]/70">
      This is a placeholder for webinars, talks, and in-person events.
    </p>
    <a href="/contact" class="mt-8 inline-block font-mono text-xs tracking-widest text-[var(--color-accent)]">GET IN TOUCH &rarr;</a>
  </section>
</Layout>
