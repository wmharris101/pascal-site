---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact">
  <section class="mx-auto max-w-2xl px-6 py-20">
    <p class="text-sm text-[var(--color-accent)]">Contact</p>
    <h1 class="mt-4 text-4xl">Tell us about the project</h1>
    <p class="prose-body mt-4 text-[var(--color-ink)]/70">
      This form is a placeholder — it currently opens an email draft. We can
      wire it up to a real form service (like Resend, Formspree, or a Vercel
      function) once the site is live.
    </p>
    <form class="mt-10 space-y-5" action="mailto:hello@example.com" method="post" enctype="text/plain">
      <div>
        <label for="name" class="block text-sm text-[var(--color-ink)]/70">Name</label>
        <input id="name" name="name" type="text" required class="mt-1 w-full border border-[var(--color-line)] bg-white px-3 py-2 text-sm" />
      </div>
      <div>
        <label for="email" class="block text-sm text-[var(--color-ink)]/70">Email</label>
        <input id="email" name="email" type="email" required class="mt-1 w-full border border-[var(--color-line)] bg-white px-3 py-2 text-sm" />
      </div>
      <div>
        <label for="message" class="block text-sm text-[var(--color-ink)]/70">Message</label>
        <textarea id="message" name="message" rows="5" required class="mt-1 w-full border border-[var(--color-line)] bg-white px-3 py-2 text-sm"></textarea>
      </div>
      <button type="submit" class="rounded-sm bg-[var(--color-accent)] px-5 py-3 text-sm text-white hover:opacity-90">
        Send message
      </button>
    </form>
  </section>
</Layout>
