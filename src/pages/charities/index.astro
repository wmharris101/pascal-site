---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Charities">
  <section class="mx-auto max-w-3xl px-6 py-20">
    <div class="mb-4 flex items-center gap-3">
      <span class="h-[5px] w-[34px] bg-[var(--color-accent)]"></span>
      <span class="font-mono text-[11px] tracking-[0.22em] text-[var(--color-ink)]/55">CHARITIES</span>
    </div>
    <h1 class="text-4xl">Causes we support</h1>
    <p class="prose-body mt-6 max-w-xl text-lg text-[var(--color-ink)]/70">
      This is a placeholder — the organizations and initiatives Pascal Method backs will be listed here.
    </p>
    <a href="/contact" class="mt-8 inline-block font-mono text-xs tracking-widest text-[var(--color-accent)]">GET IN TOUCH &rarr;</a>
  </section>
</Layout>
