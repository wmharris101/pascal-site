---
import Layout from '../../layouts/Layout.astro';
import { SERVICES } from '../../lib/servicesData';
---

<Layout title="Services" description="What Pascal Method does, channel by channel.">
  <section class="mx-auto max-w-6xl px-6 py-20">
    <div class="mb-4 flex items-center gap-3">
      <span class="h-[5px] w-[34px] bg-[var(--color-accent)]"></span>
      <span class="font-mono text-[11px] tracking-[0.22em] text-[var(--color-ink)]/55">SERVICES</span>
    </div>
    <h1 class="max-w-2xl text-4xl">What we run, channel by channel</h1>
    <div class="mt-14 grid gap-px overflow-hidden border border-[var(--color-line)] bg-[var(--color-line)] sm:grid-cols-2 lg:grid-cols-3">
      {SERVICES.map((service) => (
        <a href={`/services/${service.slug}`} class="flex flex-col gap-3 bg-[var(--color-paper)] p-8 hover:bg-[var(--color-surface)]">
          <h2 class="text-lg">{service.name}</h2>
          <p class="prose-body text-sm text-[var(--color-ink)]/65">{service.blurb}</p>
        </a>
      ))}
    </div>
  </section>
</Layout>
