---
import Layout from '../../layouts/Layout.astro';
import { sanityFetch } from '../../lib/sanity';
import { EPISODES_QUERY } from '../../lib/queries';
import { mockEpisodes } from '../../lib/mockData';
import type { PodcastEpisode } from '../../lib/types';

const episodes = await sanityFetch<PodcastEpisode[]>(EPISODES_QUERY, {}, mockEpisodes);
const dateFormatter = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Layout title="Podcast">
  <section class="mx-auto max-w-3xl px-6 py-20">
    <p class="text-sm text-[var(--color-accent)]">Podcast</p>
    <h1 class="mt-4 text-4xl">Listen in</h1>
    <ul class="mt-12 divide-y divide-[var(--color-line)] border-t border-[var(--color-line)]">
      {episodes.map((ep) => (
        <li class="py-8">
          <a href={`/podcast/${ep.slug}`} class="block">
            <p class="text-xs text-[var(--color-ink)]/50">
              {ep.episodeNumber && `Episode ${ep.episodeNumber} · `}{dateFormatter.format(new Date(ep.publishedAt))}
            </p>
            <h2 class="mt-1 text-xl">{ep.title}</h2>
            <p class="prose-body mt-2 text-[var(--color-ink)]/70">{ep.description}</p>
          </a>
        </li>
      ))}
      {episodes.length === 0 && <p class="py-8 text-[var(--color-ink)]/60">No episodes yet.</p>}
    </ul>
  </section>
</Layout>
