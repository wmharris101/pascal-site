---
const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--color-line)]">
  <div class="mx-auto flex max-w-6xl flex-col gap-4 px-6 py-10 text-sm text-[var(--color-ink)]/70 sm:flex-row sm:items-center sm:justify-between">
    <p>&copy; {year} Agency Name. All rights reserved.</p>
    <div class="flex gap-6">
      <a href="/contact" class="hover:text-[var(--color-accent)]">Contact</a>
      <a href="mailto:hello@example.com" class="hover:text-[var(--color-accent)]">hello@example.com</a>
    </div>
  </div>
</footer>
