---
const year = new Date().getFullYear();
---

<footer class="bg-[var(--color-ink)] text-[rgba(246,244,239,0.55)]">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-6 px-6 py-10">
    <div class="flex items-center gap-3">
      <span class="funnel-mark funnel-mark--light" style="--mark-unit: 3.5px;"><span></span><span></span><span></span><span></span></span>
      <span class="font-logo text-base text-[var(--color-paper)]">Pascal Method</span>
    </div>
    <p class="font-mono text-[10px] tracking-widest">&copy; {year} &middot; DTC PERFORMANCE MARKETING</p>
  </div>
</footer>
